# Fichiers .DS_Store de macOS
.DS_Store

# Cache et sorties de Gradle
.gradle
build/

# Sorties de Cargo
target/

# IntelliJ
out/
.idea
*.iml
.idea_modules/

# Journaux de crash de la JVM
hs_err_pid*
replay_pid*

# Journaux d'execution du mod (log4j), produits par les runs et les tests
java/axion-mod/logs/

# Repertoires de travail des lancements de developpement, un par tache, et le serveur
# de la campagne T-435/T-713b (ADR-161 D2)
.runs/
# Contenu personnel, de licence non verifiee : hors du depot public (ADR-161 D1)
local/

# Ressources produites par les generateurs de donnees Minecraft
src/generated/
java/axion-mod/src/generated/

# Cache de bytecode Python (outillage sous tools/)
__pycache__/
*.pyc

# Sauvegardes que Blender ecrit a chaque enregistrement (.blend1, .blend2...) :
# la source du modele est le .blend, versionne ; ses copies precedentes sont dans git.
*.blend[0-9]*
