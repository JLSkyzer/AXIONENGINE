# Fichiers .DS_Store de macOS
.DS_Store

# Cache et sorties de Gradle
.gradle
build/

# Sorties de Cargo
target/

# IntelliJ
out/
.idea
*.iml
.idea_modules/

# Journaux de crash de la JVM
hs_err_pid*
replay_pid*

# Journaux d'execution du mod (log4j), produits par les runs et les tests
java/axion-mod/logs/

# Repertoires de travail des lancements de developpement
run/
run-data/
run-gametest/

# Ressources produites par les generateurs de donnees Minecraft
src/generated/
java/axion-mod/src/generated/

# Cache de bytecode Python (outillage sous tools/)
__pycache__/
*.pyc
