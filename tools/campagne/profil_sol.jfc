<?xml version="1.0" encoding="UTF-8"?>
<!--
  Coût du sol (ADR-180, précision 14d) : un échantillon de pile par milliseconde et les allocations, pour dire où passe
  la construction d'une tuile. Posé par tools/campagne/mesure_sol.py avec son option de profil, lu par la commande jfr
  print au format JSON. (Un commentaire XML ne peut pas contenir deux tirets de suite.)
-->
<configuration version="2.0" label="AXION profil du sol" description="Echantillons Java et allocations">
  <event name="jdk.ExecutionSample">
    <setting name="enabled">true</setting>
    <setting name="period">1 ms</setting>
  </event>
  <event name="jdk.ObjectAllocationSample">
    <setting name="enabled">true</setting>
    <setting name="throttle">2000/s</setting>
    <setting name="stackTrace">true</setting>
  </event>
</configuration>
