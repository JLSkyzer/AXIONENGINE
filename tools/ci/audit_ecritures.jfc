<?xml version="1.0" encoding="UTF-8"?>
<!--
  T-437 (R-1711) : chaque écriture de fichier de la JVM, avec son chemin et sa pile, quelle que soit sa
  durée. Lu par tools/ci/audit_ecritures.py.
-->
<configuration version="2.0" label="AXION T-437" description="Ecritures de fichiers, pour l'audit de T-437">
  <event name="jdk.FileWrite">
    <setting name="enabled">true</setting>
    <setting name="stackTrace">true</setting>
    <setting name="threshold">0 ms</setting>
  </event>
</configuration>
