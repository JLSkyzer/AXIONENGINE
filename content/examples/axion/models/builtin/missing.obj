# axion:builtin/missing — asset de secours (R-522).
#
# Un cube d'un bloc de côté, centré sur l'origine. Il remplace tout asset
# refusé : la pièce manquante se voit, le monde se charge, et rien ne s'arrête.
#
# Volontairement le plus simple possible. Cet asset doit compiler sur toute
# machine où AXION démarre, sans quoi le repli aurait besoin d'un repli.
o axion_builtin_missing
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
f 1//1 3//1 2//1
f 1//1 4//1 3//1
f 5//2 6//2 7//2
f 5//2 7//2 8//2
f 1//3 2//3 6//3
f 1//3 6//3 5//3
f 4//4 8//4 7//4
f 4//4 7//4 3//4
f 1//5 5//5 8//5
f 1//5 8//5 4//5
f 2//6 3//6 7//6
f 2//6 7//6 6//6
