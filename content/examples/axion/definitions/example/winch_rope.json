{
  "schema": 6,
  "asset": "axion:models/example/winch_rope.glb",
  "kind": "machine",

  "physics": { "mass": 56.0, "collision_group": "assembly",
               "collides_with": ["world", "assembly", "entity_proxy", "debris"] },

  "parts": [
    { "name": "socle", "root_node": "socle", "material": "axion:steel",
      "health": 300.0, "structural_capacity": 20000.0, "mass": 35.0,
      "flags": ["structural"] },
    { "name": "tambour", "root_node": "tambour", "material": "axion:steel",
      "health": 200.0, "structural_capacity": 15000.0, "mass": 18.0,
      "flags": ["critical", "no_deform"] },
    { "name": "manivelle", "root_node": "manivelle", "material": "axion:steel",
      "health": 60.0, "detach_threshold": 0.0, "mass": 2.0,
      "flags": ["detachable", "repairable"] },
    { "name": "crochet", "root_node": "crochet", "material": "axion:steel",
      "health": 150.0, "mass": 1.0,
      "flags": ["no_deform"] }
  ],

  "variables": {
    "treuil": { "type": "int", "default": 0, "min": -1, "max": 1, "persist": true, "write": "none" }
  },

  "sockets": [
    { "name": "sortie_cable", "accepts": ["winch", "rope"], "anchor": true, "max_force": 15000.0,
      "winch": { "speed": 0.8, "min_length": 0.5, "max_length": 12.0, "variable": "treuil" } }
  ],

  "particles": [
    { "name": "cable", "kind": "rope", "authority": "server_simple",
      "from": { "assembly": "self", "socket": "sortie_cable" },
      "to": { "attachment": "current" },
      "segments": 24, "server_segments": 12,
      "max_length": 12.0, "stiffness": 0.9, "break_force": 15000.0,
      "radius": 0.011, "material": "axion:rope" }
  ],

  "procedural": [
    { "node": "tambour", "channel": "rotation", "axis": "x",
      "source": "attach.sortie_cable.length", "scale": -12.5 }
  ],

  "interaction": [
    { "node": "crochet", "action": "attach", "socket": "sortie_cable", "kinds": ["winch"] },
    { "node": "crochet", "action": "detach", "socket": "sortie_cable" },
    { "node": "manivelle", "action": "set_variable", "variable": "treuil", "value": -1 },
    { "node": "tambour", "action": "set_variable", "variable": "treuil", "value": 0 },
    { "node": "socle", "action": "set_variable", "variable": "treuil", "value": 1 }
  ],

  "deformation": { "enabled": true, "min_quality": "low" }
}
