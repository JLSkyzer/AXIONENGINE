# Graine R-903 : ce texte sert à la fois d'OBJ et de bibliothèque de matériaux,
# la cible de fuzzing résolvant tout `mtllib` vers lui-même.
mtllib materiaux.mtl
newmtl bois
Kd 0.8 0.6 0.4
d 0.5
Ke 1.0 0.5 0.0
Ns 250
Pr 0.5
Pm 0.25
map_Kd -s 2 2 1 -o 0.5 0 -clamp on textures/bois.png
map_Bump -bm 0.5 textures/relief.png
norm -mm 0 1 textures/normale.png
map_Ke textures/lueur.png
map_Ks -t 0.1 textures/reflet.png
newmtl vitre
Kd 1 1 1
Tr 0.75
o caisse
usemtl bois
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 1.0 1.0 0.0
v 0.0 1.0 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
o vitre
usemtl vitre
v 2.0 0.0 0.0
v 3.0 0.0 0.0
v 2.0 1.0 0.0
f 5 6 7
